<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToDo App</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <section class="task-input">
        <h1>Todo List</h1>
        <hr>
        <form action="/" method="post" class="upper-list">
            <input type="text" name="todo" id="ele1" placehulder="Enter the task" class="input">
            <select name="priority" id="Priority">
                <option value="Medium Priority">Medium Priority</option>
                <option value="High Priority">High Priority</option>
                <option value="Low Priority">Low Priority</option>
            </select>
            <button type="submit" id="add">Add</button>
        </form>

        <div class="filter" id="priorityFilter">
            <h3 id="fltrtxt">Filter by priority: <a href="" class="all">All</a>
                <a href="" class="high all">High</a> <a href="" class="medium all">Medium</a> <a href=""
                    class="low all">Low</a>
            </h3>
        </div>
        <% for(let i=0; i<ejes.length; i++){ %>
            <% if(ejes[i].todo !=='' ){ %>
                <ul>
                    <li>
                        <div class="saved-form">
                        <form action="/update" method="POST" class="added-list">
                            <input type="hidden" name="id" value="<%= ejes[i].id %>">
                                <input type="text" name="todo" placehulder="Enter the task" class="input-saved input"
                                    id="update" value=<%=ejes[i].todo %>>
                                <select name="priority" class="priority">
                                    <option value="Medium Priority" <%=ejes[i].priority==='Medium Priority' ? 'selected'
                                        : '' %>>Medium Priority</option>
                                    <option value="High Priority" <%=ejes[i].priority==='High Priority' ? 'selected'
                                        : '' %>>High Priority</option>
                                    <option value="Low Priority" <%=ejes[i].priority==='Low Priority' ? 'selected' : ''
                                        %>>Low Priority</option>
                                </select>
                                <button type="submit" class="update">Update</button>
                        </form>
                        <form action="/delete" method="POST" class="delButton">
                            <input type="hidden" name="id" value="<%= ejes[i].id %>">
                            <button type="submit" class="delete">Delete</button>
                        </form>
                        </div>
                    </li>
                </ul>
                <%}%>
                    <% } %>
                        <hr>
    </section>
    <script src="script.js"></script>

</body>

</html>
